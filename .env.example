# Access token for the scraper API. Clients send it as
#   Authorization: Bearer <token>
# Leave empty to DISABLE auth (local dev only — the resident logs a warning).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(36))"
SCRAPER_API_KEY=

# Where the resident listens. Daemon pool: 19020–19029 (resident on the first port).
SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=19020

# Fingerprint profile the browser worker loads (src/browser/profiles/*.json; ru-rtx3060, …, ru-rtx5090).
SCRAPER_PROFILE=ru-rtx3060

# Max concurrent pages inside the single browser worker.
PAGE_CONCURRENCY=10

# Max URLs from one /api/1.0/scrap/batch call loaded in parallel.
# Effective parallelism is min(SCRAPE_BATCH_CONCURRENCY, PAGE_CONCURRENCY).
SCRAPE_BATCH_CONCURRENCY=10

# --- Browser worker tuning (heavy process managed by the resident) ---
# Minutes of idle before the browser is closed (worker process stays up).
BROWSER_IDLE_EVICT_MINUTES=5.0
# Minutes of idle before the worker process exits entirely.
BROWSER_DAEMON_SHUTDOWN_MINUTES=30.0
# Seconds the resident waits for a worker response (covers cold browser launch).
DAEMON_REQUEST_TIMEOUT_SECONDS=180.0
# Seconds the resident waits for a freshly spawned worker to report healthy.
DAEMON_SPAWN_HEALTH_TIMEOUT_SECONDS=60.0
# How many times the resident retries the whole spawn flow on failure.
DAEMON_SPAWN_RETRIES=2
